{
  "manifest_version": 3,
  "name": "CC Auto Rewards - Chase Offer Auto-Adder",
  "version": "1.0.0",
  "description": "Automatically discovers and activates all available Chase credit card offers with one click.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.chase.com/*"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "CC Auto Rewards",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": [
      "src/background/service-worker.js"
    ],
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.chase.com/*"
      ],
      "js": [
        "src/utils/logger.js",
        "src/utils/cookie-helper.js",
        "src/content/chase-engine.js",
        "src/content/content-script.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cc-auto-rewards@local"
    }
  }
}
